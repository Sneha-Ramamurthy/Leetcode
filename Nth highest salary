
CREATE OR REPLACE FUNCTION NthHighestSalary(N INT)
RETURNS TABLE (Salary INT) AS $$
BEGIN
    IF N <= 0 THEN
        RETURN QUERY SELECT NULL::INT;
    ELSE
        RETURN QUERY (
            SELECT (
                SELECT DISTINCT e.Salary
                FROM Employee e
                ORDER BY e.Salary DESC
                LIMIT 1 OFFSET N - 1
            )
        );
    END IF;
END;
$$ LANGUAGE plpgsql;
